<?xml version="1.0"?>
<package format="3">
  <name>ssos_thermal</name>
  <version>0.9.0</version>
  <description>Thermal network simulation for Space Station OS, following the ssos_eclss physics/ROS split pattern</description>
  <maintainer email="spacestationos@spacedata.co.jp">Space Station OS</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>rclcpp_action</depend>
  <depend>ament_index_cpp</depend>
  <depend>space_station_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>lifecycle_msgs</depend>
  <depend>yaml-cpp</depend>

  <!-- thermal_visualization.py (PyQt5 GUI, provided by the pixi env, not rosdep) -->
  <exec_depend>rclpy</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
